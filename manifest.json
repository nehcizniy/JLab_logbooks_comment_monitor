{
  "manifest_version": 3,
  "name": "JLab Logbook Comment Monitor",
  "version": "2.12.3",
  "icons": {
    "128": "icon.png"
  },
  "description": "Checks user-selected JLab logbooks for comments, watched authors, and opened or closed beam-down events.",
  "permissions": ["alarms", "notifications", "storage", "tabs"],
  "host_permissions": ["https://logbooks.jlab.org/*", "https://ace.jlab.org/dtm/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JLab comment monitor",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
