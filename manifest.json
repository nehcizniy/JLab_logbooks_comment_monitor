{
  "manifest_version": 3,
  "name": "JLab Logbook Comment Monitor",
  "version": "3.0.0",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "description": "Checks JLab logbooks, shift crews, watched names, shift-summary edits, and beam-down events, with optional email alerts.",
  "permissions": ["alarms", "clipboardWrite", "identity", "notifications", "storage", "tabs"],
  "host_permissions": [
    "https://logbooks.jlab.org/*",
    "https://ace.jlab.org/dtm/*",
    "https://misportal.jlab.org/*",
    "https://www.jlab.org/Hall-B/pradshifts/*",
    "https://www.jlab.org/Hall-D/*",
    "https://api.github.com/repos/nehcizniy/JLab_logbooks_comment_monitor/releases/*",
    "https://gmail.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://login.microsoftonline.com/*",
    "https://graph.microsoft.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.send",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "JLab comment monitor",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
